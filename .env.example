# Model: google/gemma-4-31b-it (Gemini API free tier) | google/gemma-4-26b-a4b-it | ollama:gemma4:e4b
QUORUM_MODEL=google/gemma-4-31b-it
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/api
# native = Gemma calls tools; prefetch = code runs tools, Gemma only reasons (set from `npm run smoke`)
TOOL_MODE=native
# off = no Atlas Vector Search / embeddings (fallback if the vector index won't build)
SEMANTIC_RECALL=on

# MongoDB Atlas M0
MONGODB_URI=
MONGODB_DB=quorum

# Discord bot (discord.com/developers → New Application → Bot). No privileged intents needed.
DISCORD_BOT_TOKEN=
# Server ID (right-click server → Copy Server ID, needs Developer Mode): slash commands appear instantly
DISCORD_GUILD_ID=
# Optional role ID pinged by the 06:00 reminder
DISCORD_PING_ROLE=

# Render web service (Mastra server). RENDER_URL = what the worker calls; PUBLIC_URL = links in chat.
RENDER_URL=
PUBLIC_URL=
# any long random string; same value on Render and the laptop (openssl rand -hex 24)
QUORUM_SHARED_SECRET=
MASTRA_HOST=localhost

# Local Temporal dev server
TEMPORAL_ADDRESS=localhost:7233

# Group settings
GROUP_UTC_OFFSET=+05:00
HOME_LAT=
HOME_LON=
POLL_CLOSE=22:00
OUTING_END=10:30
RAIN_LIMIT=50

# Plan page: show first names + constraints only if everyone agreed (on|off)
PUBLIC_NAMES=off
# Landing page links (optional)
VIDEO_URL=
FEATURED_PLAN_ID=
# Optional Overpass mirror tried first
OVERPASS_URL=

# Optional live check (250 searches/month free)
SERPAPI_KEY=
