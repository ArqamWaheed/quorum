# Model: google/gemma-4-31b-it (Gemini API free tier) | google/gemma-4-26b-a4b-it | ollama:gemma4:e4b
QUORUM_MODEL=google/gemma-4-31b-it
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/api
# native = Gemma calls tools; prefetch = code runs tools, Gemma only reasons
TOOL_MODE=native

# MongoDB Atlas M0
MONGODB_URI=
MONGODB_DB=quorum

# Telegram bot (@BotFather, privacy mode ON, not an admin)
TELEGRAM_BOT_TOKEN=

# Render web service (Mastra server)
RENDER_URL=
PUBLIC_URL=
QUORUM_SHARED_SECRET=
MASTRA_HOST=localhost

# Local Temporal dev server
TEMPORAL_ADDRESS=localhost:7233

# Group settings
GROUP_UTC_OFFSET=+05:00
HOME_LAT=
HOME_LON=
POLL_CLOSE=22:00
OUTING_END=10:30
RAIN_LIMIT=50

# Optional live check (250 searches/month free)
SERPAPI_KEY=
